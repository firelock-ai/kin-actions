    "allow_rebase_merge": false,
    "squash_merge_commit_title": "PR_TITLE",
    "squash_merge_commit_message": "PR_BODY"
  },
  "release_a": "first kin-actions release containing the train and recovery controllers while consumers.json still inventories only already-live pins",
  "release_b": "next kin-actions release after every Release A caller is live and the eight exact future caller paths are added to consumers.json",
