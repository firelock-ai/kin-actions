      "ci_workflow_run",
      "registry_publish_workflow_run",
      "repository_dispatch",
      "schedule"
    ],
    "secrets": "inherit"
  },
  "release_a": "first kin-actions release containing the train and recovery controllers while consumers.json still inventories only already-live pins",
